    <string name="about">关于</string>
    <string name="version">版本 %1$s (%2$s)</string>
    <string name="about_overview">简介</string>
    <string name="about_summary">Fuyao Locale 是一款双主题语言管理工具，可管理应用独立语言与系统语言列表，适用于系统未提供合适管理界面的设备。</string>
    <string name="about_regional_display_statement">一个中国原则及地区显示声明</string>
    <string name="about_regional_display_statement_body">Fuyao Locale 及其开发者坚持一个中国原则。应用中如出现台湾地区相关名称或旗帜符号，其地区名称来源于 Android 系统的区域设置数据，旗帜符号则由通用逻辑依据地区代码生成标准 Unicode 字符序列，并由设备系统字库渲染，并非开发者针对该地区单独编写名称或设计、绘制旗帜图案。上述显示仅反映设备系统的数据及渲染支持情况，不代表本应用及开发者立场的改变或偏离。</string>
    <string name="about_features">核心特性</string>
    <string name="about_feature_per_app">单应用语言设置</string>
    <string name="about_feature_per_app_summary">查看当前语言、设置已支持的语言，或恢复为系统默认语言。</string>
    <string name="about_feature_system_languages">系统语言列表</string>
    <string name="about_feature_system_languages_summary">添加被厂商隐藏的语言、调整顺序，并保存系统级语言偏好。</string>
    <string name="about_feature_batch">批量设置语言</string>
    <string name="about_feature_batch_summary">长按应用进入多选模式，然后为多个应用应用同一种语言。</string>
    <string name="about_feature_filters">搜索与筛选</string>
    <string name="about_feature_filters_summary">搜索应用、仅显示已修改项目、选择排序方式，并显示或隐藏系统应用。</string>
    <string name="about_feature_quick_settings">快捷设置磁贴</string>
    <string name="about_feature_quick_settings_summary">置顶常用语言，并通过系统快捷设置磁贴循环切换。</string>
    <string name="about_feature_adaptive">双主题与自适应布局</string>
    <string name="about_feature_adaptive_summary">双主题原生 UI、手机端底部导航、大屏列表—详情布局，以及边到边系统栏。</string>
    <string name="about_requirement_android">Android 13（API 33）或更高版本。</string>
    <string name="about_requirement_shizuku">需要安装并启动 Shizuku，并向 Fuyao Locale 授权。</string>
    <string name="about_usage_notes">使用说明</string>
    <string name="about_usage_note">Fuyao Locale 不会翻译其他应用，而是请求 Android 为目标应用设置其已经支持的语言。系统应用和不受支持的语言可能出现不可预期的行为。</string>
        <string name="about_credits_and_references">引用与参考项目</string>
<string name="about_this_project">本项目</string>
    <string name="about_reference_projects">参考项目</string>
    <string name="about_cited_projects">引用项目</string>
    <string name="about_theme">主题</string>
    <string name="theme_liquid_glass_navigation_bar">液态玻璃标签栏</string>
    <string name="theme_liquid_glass_navigation_bar_summary">将底部标签栏渲染为折射壁纸的玻璃效果</string>
    <string name="about_credits">Fuyao Locale 在 VegaBobo 的 Language Selector 的思路和功能基础上进行了大幅重写；系统语言列表功能参考了 Nightdavisao 的 MultiLocale；液态玻璃标签栏与 Miuix 主题基于 Kyant0 的 AndroidLiquidGlass 与 miuix 构建。</string>
    <string name="about_license">Fuyao Locale 采用 GNU AGPL v3 only（AGPL-3.0-only）许可；源自 Language Selector 的部分继续保留 Apache License 2.0 许可证与署名。MultiLocale 采用 MIT 许可证发布。AndroidLiquidGlass 与 miuix 采用 Apache License 2.0 许可证发布。</string>
