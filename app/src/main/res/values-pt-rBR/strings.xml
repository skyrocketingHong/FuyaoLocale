    <string name="about_overview">Visão geral</string>
    <string name="about_summary">Fuyao Locale é uma ferramenta Material 3 para visualizar e gerenciar idiomas por aplicativo quando não há uma interface adequada no sistema.</string>
    <string name="about_features">Principais recursos</string>
    <string name="about_feature_per_app">Controle de idioma por app</string>
    <string name="about_feature_per_app_summary">Veja o idioma atual, defina um idioma compatível ou restaure o padrão do sistema.</string>
    <string name="about_feature_batch">Definição de idioma em lote</string>
    <string name="about_feature_batch_summary">Toque e segure para selecionar vários apps e aplicar o mesmo idioma a todos.</string>
    <string name="about_feature_filters">Busca e filtros</string>
    <string name="about_feature_filters_summary">Busque apps, exiba apenas itens modificados, altere a ordenação e mostre ou oculte apps do sistema.</string>
    <string name="about_feature_quick_settings">Bloco de Configurações rápidas</string>
    <string name="about_feature_quick_settings_summary">Fixe idiomas frequentes e alterne entre eles pelo bloco de Configurações rápidas.</string>
    <string name="about_feature_adaptive">Material 3 e layout adaptável</string>
    <string name="about_feature_adaptive_summary">Interface Material 3 nativa com navegação inferior no celular, lista e detalhes em telas grandes e barras do sistema de ponta a ponta.</string>
    <string name="about_requirements">Requisitos</string>
    <string name="about_requirement_android">Android 13 (API 33) ou posterior.</string>
    <string name="about_requirement_shizuku">O Shizuku deve estar instalado, em execução e autorizado para o Fuyao Locale.</string>
    <string name="about_usage_notes">Notas de uso</string>
    <string name="about_usage_note">Fuyao Locale não traduz apps. Ele solicita ao Android que aplique um idioma já compatível com o app selecionado. Apps do sistema e idiomas sem suporte podem se comportar de forma inesperada.</string>
    <string name="about_credits_license">Créditos e licença</string>
    <string name="about_open_source">Código aberto</string>
    <string name="about_credits">Fuyao Locale é uma reescrita substancial baseada nos conceitos e recursos do Language Selector, de VegaBobo.</string>
    <string name="about_license">Fuyao Locale é licenciado somente sob a GNU AGPL v3 (AGPL-3.0-only). As partes derivadas do Language Selector mantêm os avisos da Apache License 2.0.</string>
