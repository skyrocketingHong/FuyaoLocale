    <string name="about_feature_filters">Encontre o app que procura</string>
    <string name="about_feature_filters_summary">Busque por nome ou pacote, filtre apps alterados ou do sistema e escolha a ordem da lista.</string>
    <string name="about_feature_quick_settings">Idiomas do dia a dia, sempre à mão</string>
    <string name="about_feature_quick_settings_summary">Fixe os idiomas que mais usa. O bloco de Configurações rápidas alterna os idiomas do app não pertencente ao sistema que está em uso.</string>
    <string name="about_feature_adaptive">Moderno ou clássico. Você escolhe.</string>
    <string name="about_feature_adaptive_summary">Escolha uma interface moderna ou um estilo clássico do Android, claro ou escuro. O layout acompanha o tamanho da janela.</string>
    <string name="about_requirement_android">Requer Android 13 ou posterior.</string>
    <string name="about_requirement_shizuku">O Shizuku deve estar ativo e autorizado.</string>
    <string name="about_usage_notes">Notas de uso</string>
    <string name="about_usage_note">Os idiomas disponíveis dependem de cada app; o Fuyao Locale não traduz conteúdo.</string>
