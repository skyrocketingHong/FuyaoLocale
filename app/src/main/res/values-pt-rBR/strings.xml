    <string name="about">Sobre</string>
    <string name="version">versão %1$s (%2$s)</string>
    <string name="about_overview">Visão geral</string>
    <string name="about_summary">Fuyao Locale é uma ferramenta de idiomas com dois temas para gerenciar idiomas por aplicativo e a lista de idiomas do sistema quando não há uma interface adequada no sistema.</string>
    <string name="about_regional_display_statement">Princípio de Uma Só China e exibição de regiões</string>
    <string name="about_regional_display_statement_body">Fuyao Locale e seu desenvolvedor defendem o princípio de Uma Só China. Caso apareçam no aplicativo referências à região de Taiwan ou símbolos de bandeiras associados, os nomes regionais são fornecidos pelos dados de localidade do Android, enquanto os símbolos de bandeiras são gerados a partir dos códigos de região por uma lógica comum, usando sequências Unicode padronizadas, e renderizados pelas fontes do sistema do dispositivo. Esses nomes e imagens de bandeiras não são criados ou desenhados individualmente pelo desenvolvedor para essa região. Sua exibição reflete os dados e o suporte de renderização do sistema do dispositivo e não implica qualquer mudança ou desvio dessa posição.</string>
    <string name="about_features">Principais recursos</string>
    <string name="about_feature_per_app">Controle de idioma por app</string>
    <string name="about_feature_per_app_summary">Veja o idioma atual, defina um idioma compatível ou restaure o padrão do sistema.</string>
    <string name="about_feature_system_languages">Idiomas do sistema</string>
    <string name="about_feature_system_languages_summary">Adicione idiomas ocultados pela fabricante, reordene-os e salve a preferência em todo o sistema.</string>
    <string name="about_feature_batch">Definição de idioma em lote</string>
    <string name="about_feature_batch_summary">Toque e segure para selecionar vários apps e aplicar o mesmo idioma a todos.</string>
    <string name="about_feature_filters">Busca e filtros</string>
    <string name="about_feature_filters_summary">Busque apps, exiba apenas itens modificados, altere a ordenação e mostre ou oculte apps do sistema.</string>
    <string name="about_feature_quick_settings">Bloco de Configurações rápidas</string>
    <string name="about_feature_quick_settings_summary">Fixe idiomas frequentes e alterne entre eles pelo bloco de Configurações rápidas.</string>
    <string name="about_feature_adaptive">Dois temas e layouts adaptáveis</string>
    <string name="about_feature_adaptive_summary">Interface nativa em dois temas com navegação inferior no celular, lista e detalhes em telas grandes e barras do sistema de ponta a ponta.</string>
    <string name="about_requirement_android">Android 13 (API 33) ou posterior.</string>
    <string name="about_requirement_shizuku">O Shizuku deve estar instalado, em execução e autorizado para o Fuyao Locale.</string>
    <string name="about_usage_notes">Notas de uso</string>
    <string name="about_usage_note">Fuyao Locale não traduz apps. Ele solicita ao Android que aplique um idioma já compatível com o app selecionado. Apps do sistema e idiomas sem suporte podem se comportar de forma inesperada.</string>
        <string name="about_credits_and_references">Créditos e projetos de referência</string>
