<item name="android:colorButtonNormal">@color/lollipop_btn_default_material_light</item>
<item name="android:textColorPrimary">@color/lollipop_primary_text_material_light</item>
<item name="android:textColorSecondary">@color/lollipop_secondary_text_material_light</item>
<item name="android:colorControlNormal">@color/lollipop_secondary_text_material_light</item>
<item name="android:colorForeground">#ff000000</item>
<item name="android:disabledAlpha">@dimen/lollipop_disabled_alpha_material_light</item>
<item name="lollipop_colorSwitchThumbNormal">@color/lollipop_switch_thumb_material_light</item>
</style>
