    <string name="about_overview">Overview</string>
    <string name="about_summary">Manage app languages, system language order, and reusable configurations.</string>
    <string name="about_regional_display_statement">One-China principle and regional display</string>
    <string name="about_regional_display_statement_body">Fuyao Locale and its developer uphold the one-China principle. Region names come from Android, and flags are displayed through Unicode and system fonts; this includes Taiwan-related displays and does not change that position.</string>
    <string name="about_features">Languages, your way</string>
    <string name="about_feature_per_app">One app. Your choice.</string>
    <string name="about_feature_per_app_summary">Choose a supported language for each app or follow the system.</string>
    <string name="about_feature_system_languages">System languages, in your order</string>
    <string name="about_feature_system_languages_summary">Add languages, reorder them, then save.</string>
    <string name="about_feature_batch">Keep your favorite combinations</string>
    <string name="about_feature_batch_summary">Set languages in batches and save, import, or reuse configurations.</string>
    <string name="about_feature_filters">Find the app you have in mind</string>
    <string name="about_feature_filters_summary">Search by name or package, filter changed or system apps, and choose a sort order.</string>
    <string name="about_feature_quick_settings">Everyday languages, close at hand</string>
    <string name="about_feature_quick_settings_summary">Pin the languages you use most. Use the Quick Settings tile to cycle languages for the non-system app currently in use.</string>
    <string name="about_feature_adaptive">Modern or classic. Make it yours.</string>
    <string name="about_feature_adaptive_summary">Choose a modern interface or a classic Android style, in light or dark. The layout adapts as your window changes.</string>
    <string name="about_requirement_android">Requires Android 13 or later.</string>
    <string name="about_requirement_shizuku">Shizuku must be running and authorized.</string>
    <string name="about_usage_notes">Usage notes</string>
    <string name="about_usage_note">Available languages depend on each app; Fuyao Locale does not translate content.</string>
