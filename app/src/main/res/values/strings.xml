    <string name="about_overview">Overview</string>
    <string name="about_summary">Fuyao Locale is a dual-theme language tool for managing per-app languages and the system language list when a suitable system interface is unavailable.</string>
    <string name="about_regional_display_statement">One-China principle and regional display</string>
    <string name="about_regional_display_statement_body">Fuyao Locale and its developer uphold the One-China principle. If references to the Taiwan region or associated flag symbols appear in the app, the regional names are supplied by Android\'s locale data, while flag symbols are generated from region codes using standard Unicode sequences and rendered by the device\'s system fonts. These names and flag graphics are not individually authored or designed by the developer for that region. Their appearance reflects the device\'s system data and rendering support and does not imply any change in, or departure from, this position.</string>
    <string name="about_features">Highlights</string>
    <string name="about_feature_per_app">Per-app language controls</string>
    <string name="about_feature_per_app_summary">View the current language, set a supported language, or reset it to the system default.</string>
    <string name="about_feature_system_languages">System language list</string>
    <string name="about_feature_system_languages_summary">Add languages the OEM hides, reorder them, and save the system-wide preference.</string>
    <string name="about_feature_batch">Batch language setting</string>
    <string name="about_feature_batch_summary">Long-press apps to enter selection mode, then apply one locale to multiple apps.</string>
    <string name="about_feature_filters">Search and filters</string>
    <string name="about_feature_filters_summary">Search apps, show only modified entries, choose a sort order, and show or hide system apps.</string>
    <string name="about_feature_quick_settings">Quick Settings tile</string>
    <string name="about_feature_quick_settings_summary">Pin frequently used locales and cycle them from the system Quick Settings tile.</string>
    <string name="about_feature_adaptive">Two themes and adaptive layouts</string>
    <string name="about_feature_adaptive_summary">Native UI in two themes with phone bottom navigation, large-screen list-detail layout, and edge-to-edge system bars.</string>
    <string name="about_requirement_android">Android 13 (API 33) or later.</string>
    <string name="about_requirement_shizuku">Shizuku must be installed, running, and authorized for Fuyao Locale.</string>
    <string name="about_usage_notes">Usage notes</string>
    <string name="about_usage_note">Fuyao Locale does not translate apps. It asks Android to apply a locale already supported by the selected app. System apps and unsupported locales may behave unexpectedly.</string>
        <string name="about_credits_and_references">Credits and reference projects</string>
